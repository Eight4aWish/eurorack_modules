// secrets.h.example — copy to `secrets.h` (same folder) and fill in.
// `secrets.h` is gitignored.
//
//     cp include/esp32-clklinkrec/secrets.h.example include/esp32-clklinkrec/secrets.h
//     # then edit secrets.h
//
// Used by the esp32-clklinkrec WiFi diagnostic and (eventually) the
// Ableton Link integration. SSID must be a dual-band network if you want
// to land on 5 GHz — most routers expose a single SSID that the C5 picks
// a band on automatically based on signal strength.

#pragma once

#define WIFI_SSID "your-network-name"
#define WIFI_PASS "your-network-password"
