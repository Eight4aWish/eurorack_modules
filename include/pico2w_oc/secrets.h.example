// secrets.h.example — copy this file to `secrets.h` (in the same folder)
// and fill in your actual values. `secrets.h` is gitignored.
//
//     cp include/pico2w_oc/secrets.h.example include/pico2w_oc/secrets.h
//     # then edit include/pico2w_oc/secrets.h
//
// Used by src/pico2w_oc/main.cpp for the "Net" patch (RTP-MIDI over WiFi).
// If this file is absent the firmware still builds — the Net patch just
// falls back to the placeholder SSID below and reports "no WiFi" on the OLED.

#pragma once

// Home / studio WiFi network the module should join for network MIDI.
// The Pico 2 W is 2.4 GHz only — point it at a 2.4 GHz SSID.
#define WIFI_SSID "your-network-name"
#define WIFI_PASS "your-network-password"

// RTP-MIDI session name advertised to the host (rtpMIDI / macOS Network MIDI).
#define NET_MIDI_NAME "Pico2W-OC"
