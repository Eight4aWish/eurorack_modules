# Build outputs (local only)
build_artifacts/
release_staging/
.pio/

# VS Code local settings caches
.vscode/**
!.vscode/settings.json
!.vscode/c_cpp_properties.json

# Platform-specific temp files
.DS_Store

# Do not track embedded Daisy libraries here
libs/daisy_duino/
.pio/
.DS_Store
build/
/EuroPi

# Generated by the IDF Component Manager when building arduino, espidf envs
# (currently just esp32-clklink). dependencies.lock and the project-root
# CMakeLists.txt are committed; managed_components/ and the full generated
# sdkconfig (which derives from sdkconfig.defaults) are not.
managed_components/
sdkconfig.esp32-clklink
sdkconfig.esp32-clklinkrec

# Per-developer WiFi / OTA credentials (use the .example file as a template)
include/shared/secrets.h
include/*/secrets.h
src/*/secrets.h

# Python tools (tools/llm-proxy/) — virtualenv, byte-cache, build metadata
**/.venv/
**/__pycache__/
**/*.egg-info/

# Per-user secrets (API keys, hostnames). Use .env.example as a template.
**/.env

# Per-user saved data (LLM proxy bank library, runtime logs)
tools/llm-proxy/banks.json
tools/llm-proxy/banks.json.tmp
tools/llm-proxy/proxy.log
