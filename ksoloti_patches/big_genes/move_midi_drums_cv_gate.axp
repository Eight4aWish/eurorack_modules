   <patchobj type="patch/object" uuid="62ad1a4d-4c13-4430-9564-8bfb47e5b2d3" name="dbg_drums" x="280" y="518">
      <params/>
      <attribs/>
      <object id="patch/object" uuid="62ad1a4d-4c13-4430-9564-8bfb47e5b2d3">
         <sDescription>Formats drum activity for OLED (kick/snare/hat gates).</sDescription>
         <author>generated</author>
         <license>BSD</license>
         <inlets>
            <bool32 name="kick" description="kick gate"/>
            <bool32 name="snare" description="snare gate"/>
            <bool32 name="hat"/>
            <bool32 name="open" description="open gate"/>
         </inlets>
         <outlets>
            <charptr32 name="str" description="string output"/>
         </outlets>
         <displays/>
         <params/>
         <attribs/>
         <includes>
            <include>os/various/chprintf.h</include>
         </includes>
         <code.declaration><![CDATA[char c[22];]]></code.declaration>
         <code.krate><![CDATA[int32_t k = inlet_kick ? 1 : 0;
int32_t s = inlet_snare ? 1 : 0;
int32_t h = inlet_hat ? 1 : 0;
int32_t o = inlet_open ? 1 : 0;
chsnprintf(c, 22, "DRM KSH=%d%d%d%d", (int)k, (int)s, (int)h, (int)o);
outlet_str = &c[0];]]></code.krate>
      </object>
   </patchobj>
