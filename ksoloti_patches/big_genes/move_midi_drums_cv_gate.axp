<patch-1.0 appVersion="1.0.12">
   <comment type="patch/comment" x="154" y="14" text="&lt;html&gt;&lt;h2&gt;Ableton Move → Ksoloti Big Genes&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;MIDI ch10 drums: 36=Kick, 38=Snare, 42=Hat&lt;/li&gt;&lt;li&gt;MIDI ch1 → CV1+Gate1 (pitch+gate)&lt;/li&gt;&lt;li&gt;MIDI ch2 → CV2+Gate2 (pitch+gate)&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;Tip: Use Big Genes &lt;i&gt;cv out big genes&lt;/i&gt; patch to calibrate 1V/oct.&lt;/p&gt;&lt;/html&gt;"/>
   <obj type="ksoloti/big genes/cv out b" uuid="28629cd3-e124-4434-8179-a9b0c40cfcd1" name="cv_1" x="840" y="28">
      <params/>
      <attribs>
         <combo attributeName="output" selection="CV1 (PA4)"/>
         <combo attributeName="offset" selection="C4 (-4) = 0V (Eurorack)"/>
         <combo attributeName="when_stopped" selection="center"/>
      </attribs>
   </obj>
   <patchobj type="patch/object" uuid="c2f2a4f4-d17e-456a-94d1-80ac126a51e6" name="dbg_ch1" x="546" y="42">
      <params/>
      <attribs>
         <spinner attributeName="ch" value="1"/>
      </attribs>
      <object id="patch/object" uuid="c2f2a4f4-d17e-456a-94d1-80ac126a51e6">
         <sDescription>Formats a simple channel status line (note+gate) for OLED.</sDescription>
         <author>generated</author>
         <license>BSD</license>
         <inlets>
            <frac32.bipolar name="note" description="MIDI note from keyb ch"/>
            <bool32 name="gate" description="gate"/>
         </inlets>
         <outlets>
            <charptr32 name="str" description="string output"/>
         </outlets>
         <displays/>
         <params/>
         <attribs>
            <spinner name="ch" MinValue="1" MaxValue="16" DefaultValue="1"/>
         </attribs>
         <includes>
            <include>os/various/chprintf.h</include>
         </includes>
         <code.declaration><![CDATA[char c[22];]]></code.declaration>
         <code.krate><![CDATA[int32_t note_q = inlet_note >> 21;
int32_t midi = note_q + 64;
int32_t g = inlet_gate ? 1 : 0;
if (midi < 0) midi = 0;
if (midi > 127) midi = 127;
chsnprintf(c, 22, "CH%d N=%03d G=%d", attr_ch, (int)midi, (int)g);
outlet_str = &c[0];]]></code.krate>
      </object>
   </patchobj>
   <obj type="audio/outconfig" uuid="eace67e3304afaa1bb695b444e9345f2d8adaf00" name="outconfig_1" x="14" y="98">
      <params/>
      <attribs>
         <combo attributeName="headphones" selection="-12dB"/>
         <combo attributeName="mode" selection="Stereo"/>
      </attribs>
   </obj>
   <patchobj type="patch/object" uuid="6e6d5c7b-0f0f-4b64-8d76-8a2c39f11d4f" name="dbg_header" x="784" y="126">
      <params/>
      <attribs/>
      <object id="patch/object" uuid="6e6d5c7b-0f0f-4b64-8d76-8a2c39f11d4f">
         <sDescription>Constant header string for OLED diagnostics.</sDescription>
         <author>generated</author>
         <license>BSD</license>
         <inlets/>
         <outlets>
            <charptr32 name="str" description="string output"/>
         </outlets>
         <displays/>
         <params/>
         <attribs/>
         <includes/>
         <code.declaration><![CDATA[char c[22] = "MOVE MIDI DBG";]]></code.declaration>
         <code.krate><![CDATA[outlet_str = &c[0];]]></code.krate>
      </object>
   </patchobj>
