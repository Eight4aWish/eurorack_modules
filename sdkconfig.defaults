# Shared ESP-IDF config overrides for the Ableton Link builds
# (esp32_clklink on classic ESP32, esp32_clklinkrec on Xiao ESP32-C5).
# Picked up automatically by pioarduino for every env. Target-specific
# overrides live in sdkconfig.defaults.<target> (e.g. .esp32, .esp32c5).

# Arduino-as-IDF-component requires 1000 Hz tick rate.
CONFIG_FREERTOS_HZ=1000

# Ableton Link's ASIO uses C++ exceptions and RTTI (typeinfo for
# std::error_category lives behind RTTI).
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y

# Make the Arduino framework provide app_main() that calls our setup()/loop().
# Without this we get "undefined reference to app_main" at link time.
CONFIG_AUTOSTART_ARDUINO=y
